<Overlay @position="right" @noBackdrop={{true}} @isResizable={{true}} @fullHeight={{true}} @width="570px">
    <Overlay::Header
        @title="Create New Bus Route"
        @onPressCancel={{transition-to "operations.bus-routes.index"}}
    >
        <Button @icon="check" @type="primary" @text="Create Bus Route" @onClick={{this.saveRoute}}  @isLoading={{this.isSubmitting}} @disabled={{this.isSubmitting}} />
    </Overlay::Header>

    <Overlay::Body @wrapperClass="new-service-rate-overlay-body px-4 space-y-4 pt-4">

        {{!-- SECTION 1: BASIC DETAILS --}}
        <ContentPanel @title="Basic Details" @open={{true}} @pad={{true}} @panelBodyClass="bg-white dark:bg-gray-800">
            <div class="grid grid-cols-1 gap-4">
                
                <div class="grid grid-cols-2 gap-4">
                    <div class="input-group">
                        <InputLabel @labelText="Select Country (Africa)" @required={{true}} />
                        <Select 
                            @options={{this.africaCountries}} 
                            @value={{this.model.country}} 
                            @onSelect={{fn (mut this.model.country)}} 
                            @placeholder="Choose Country"
                            class="w-full" 
                        />
                    </div>

                    {{!-- ✅ Travel Type dropdown add kiya --}}
                    <div class="input-group">
                        <InputLabel @labelText="Travel Type" @required={{true}} />
                        <Select 
                            @options={{this.travelTypes}} 
                            @value={{this.model.travel_type}} 
                            @onSelect={{fn (mut this.model.travel_type)}} 
                            @placeholder="Select Travel Type"
                            class="w-full" 
                        />
                    </div>
                </div>

                <div class="grid grid-cols-2 gap-4">
                    <div class="input-group">
                        <InputLabel @labelText="Departure City" @required={{true}} />
                        <Select @options={{this.cities}} @value={{this.model.departure_city}} @onSelect={{fn (mut this.model.departure_city)}} @placeholder="Select Departure" class="w-full" />
                    </div>

                    <div class="input-group">
                        <InputLabel @labelText="Arrival City" @required={{true}} />
                        <Select @options={{this.cities}} @value={{this.model.arrival_city}} @onSelect={{fn (mut this.model.arrival_city)}} @placeholder="Select Arrival" class="w-full" />
                    </div>
                </div>

                {{!-- <div class="input-group">
                    <InputLabel @labelText="Assign Vendor (Intercity Operator)" @required={{true}} />
                    <Select 
                        @options={{this.vendors}} 
                        @value={{this.model.vendor}} 
                        @optionLabel="name" 
                        {{! CHANGE HERE: mut ki jagah handleVendorSelection use karein }}
                        @onSelect={{this.handleVendorSelection}} 
                        @placeholder="Select Vendor"
                        class="w-full" 
                    />
                </div> --}}

                <div class="input-group">
                    <InputLabel @labelText="Assign Vendor (Intercity Operator)" @required={{true}} />
                    <ModelSelect
                        @modelName="vendor"
                        @selectedModel={{this.model.vendor}}
                        @placeholder="Search or Select Vendor"
                        @triggerClass="form-select form-input w-full"
                        @infiniteScroll={{true}}
                        @renderInPlace={{true}}
                        @onChange={{this.handleVendorSelection}}
                        @query={{hash type="intercity-bus-operator"}}
                        as |vendor|
                    >
                        <div class="flex items-center">
                            <div class="truncate font-semibold">{{vendor.name}}</div>
                        </div>
                    </ModelSelect>
                </div>

                {{!-- <div class="input-group">
                    <InputLabel @labelText="Bus Park Departure Location" @helpText="Enter the full address or landmark" @required={{true}} />
                    <Input @value={{this.model.departure_address}} class="form-input w-full" placeholder="e.g. Ojota Motor Park, Lagos" />
                </div>

                <div class="input-group">
                    <InputLabel @labelText="Bus Park Arrival Location" @helpText="Enter the full address or landmark" @required={{true}} />
                    <Input @value={{this.model.arrival_address}} class="form-input w-full" placeholder="e.g. Utako Market Park, Abuja" />
                </div> --}}

                {{!-- 🚌 Bus Park Departure Location --}}
                <div class="input-group">
                    <InputLabel @labelText="Bus Park Departure Location" @helpText="Select the station or terminal" @required={{true}} />
                    <ModelSelect
                        @modelName="place"
                        @selectedModel={{this.model.departure_location}}
                        @placeholder="Select Departure Bus Park/Terminal"
                        @triggerClass="form-select form-input w-full"
                        @infiniteScroll={{true}}
                        @renderInPlace={{true}}
                        @customSearchEndpoint="places/search"
                        @onChange={{this.selectDepartureLocation}}
                        @query={{hash type=(array "Bus Station" "Bus Terminal" "Railway Station" "Ferry Terminal")}}
                        as |model|
                    >
                        <div class="flex items-center justify-between">
                            <div class="truncate flex-1">{{model.address}}</div>
                            <Badge @hideStatusDot={{true}} @status="info">{{model.type}}</Badge>
                        </div>
                    </ModelSelect>
                </div>

                {{!-- 🚌 Bus Park Arrival Location --}}
                <div class="input-group">
                    <InputLabel @labelText="Bus Park Arrival Location" @helpText="Select the station or terminal" @required={{true}} />
                    <ModelSelect
                        @modelName="place"
                        @selectedModel={{this.model.arrival_location}}
                        @placeholder="Select Arrival Bus Park/Terminal"
                        @triggerClass="form-select form-input w-full"
                        @infiniteScroll={{true}}
                        @renderInPlace={{true}}
                        @customSearchEndpoint="places/search"
                        @onChange={{this.selectArrivalLocation}}
                        @query={{hash type=(array "Bus Station" "Bus Terminal" "Railway Station" "Ferry Terminal")}}
                        as |model|
                    >
                        <div class="flex items-center justify-between">
                            <div class="truncate flex-1">{{model.address}}</div>
                            <Badge @hideStatusDot={{true}} @status="info">{{model.type}}</Badge>
                        </div>
                    </ModelSelect>
                </div>

                <div class="grid grid-cols-2 gap-4 border-t border-gray-100 dark:border-gray-700 pt-4">
                    <div class="input-group">
                        <InputLabel @labelText="Route Ticket Price" @required={{true}} />
                        <Input @type="number" @value={{this.model.price}} class="form-input w-full" placeholder="0.00" />
                    </div>

                    <div class="input-group">
                        <InputLabel @labelText="Route Class" />
                        <Select @options={{this.routeClasses}} @value={{this.model.route_class}} @onSelect={{fn (mut this.model.route_class)}} class="w-full" />
                    </div>
                </div>
            </div>
        </ContentPanel>

        {{!-- SECTION 2: AVAILABILITY --}}
        <ContentPanel @title="Availability" @open={{true}} @pad={{true}} @panelBodyClass="bg-white dark:bg-gray-800">
            <div class="flex items-center justify-between p-4 bg-gray-100 dark:bg-gray-900 border border-gray-200 dark:border-gray-700 rounded-lg mb-6">
                <div>
                    <h4 class="text-sm font-semibold text-gray-800 dark:text-white">Same timing for all days?</h4>
                    <p class="text-xs text-gray-500">Switch off to set different times for each day</p>
                </div>
                <Toggle @isToggled={{this.useSameTime}} @onToggle={{this.toggleTimeMode}} />
            </div>

            {{#if this.useSameTime}}
                <div class="space-y-6">
                    <div class="input-group max-w-xs">
                        <InputLabel @labelText="Departure Time" @required={{true}} />
                        <Input 
                            @type="time" 
                            @value={{this.model.departure_time}} 
                            class="form-input w-full bg-white dark:bg-gray-800 border-gray-300 dark:border-gray-700 p-2.5 rounded-md" 
                        />
                    </div>

                    <div class="input-group">
                        <InputLabel @labelText="Operating Days" @required={{true}} />
                        <div class="grid grid-cols-4 gap-3 mt-2">
                            {{#each this.daysOfWeek as |day|}}
                                <label 
                                    class="flex flex-col items-center justify-center gap-2 px-2 py-3 border rounded-lg cursor-pointer transition-all select-none
                                        {{if (includes day this.model.operating_days) 
                                            'bg-blue-600 border-blue-500 text-white' 
                                            'bg-gray-800 border-gray-600 text-gray-400 hover:border-gray-400'}}"
                                >
                                    <span class="text-xs font-bold uppercase tracking-wider text-center">{{day}}</span>
                                    <input 
                                        type="checkbox"
                                        checked={{includes day this.model.operating_days}}
                                        {{on "change" (fn this.toggleDay day)}}
                                        class="w-4 h-4 rounded accent-white cursor-pointer"
                                    />
                                </label>
                            {{/each}}
                        </div>
                    </div>
                </div>
            {{else}}
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    {{#each this.daysOfWeek as |day|}}
                        {{#let (get this.customSchedule day) as |dayConfig|}}
                            <div class="flex flex-col p-3 border rounded-lg transition-all {{if dayConfig.enabled 'border-blue-500 bg-blue-50 dark:bg-blue-900/10' 'border-gray-200 dark:border-gray-800 opacity-60'}}">
                                <div class="flex items-center justify-between mb-2">
                                    <span class="text-xs font-bold uppercase {{if dayConfig.enabled 'text-blue-600' 'text-gray-500'}}">
                                        {{day}}
                                    </span>
                                    <Input 
                                        @type="checkbox" 
                                        @checked={{dayConfig.enabled}} 
                                        {{on "change" (fn this.updateSchedule day 'enabled')}} 
                                        class="form-checkbox h-4 w-4 text-blue-600"
                                    />
                                </div>
                                
                                {{#if dayConfig.enabled}}
                                    <div class="mt-1">
                                        <label class="text-[10px] text-gray-500 uppercase font-bold mb-1 block">Departure Time</label>
                                        <Input 
                                            @type="time" 
                                            @value={{dayConfig.time}} 
                                            {{on "change" (fn this.updateSchedule day 'time')}}
                                            class="form-input w-full text-sm p-2 rounded" 
                                        />
                                    </div>
                                {{else}}
                                    <div class="text-[11px] text-gray-500 py-3 italic text-center">Not Operating</div>
                                {{/if}}
                            </div>
                        {{/let}}
                    {{/each}}
                </div>
            {{/if}}
        </ContentPanel>

        {{!-- SECTION 3: DOCUMENTS --}}
        <ContentPanel @title="Documents & Images" @open={{true}} @pad={{true}} @panelBodyClass="bg-white dark:bg-gray-800">
            <div class="space-y-4">
                {{#if this.isUploading}}
                    <div class="dropzone w-full rounded-lg px-4 py-8 bg-gray-50 dark:bg-gray-900 text-center flex flex-col items-center justify-center border-2 border-dashed border-gray-200 dark:border-indigo-500">
                        <Spinner class="text-sm dark:text-gray-100" @loadingMessage="Uploading..." />
                    </div>
                {{else}}
                    {{#let (file-queue name="files" onFileAdded=this.queueFile accept=(join "," this.acceptedFileTypes)) as |queue|}}
                        <FileDropzone @queue={{queue}} class="dropzone file-dropzone" as |dropzone|>
                            {{#if dropzone.active}}
                                {{#if dropzone.valid}}
                                    {{t "component.dropzone.drop-to-upload"}}
                                {{else}}
                                    {{t "component.dropzone.invalid"}}
                                {{/if}}
                            {{else if queue.files.length}}
                                <div class="my-2">
                                    <FaIcon @icon="folder-open" class="text-indigo-500 mr-2" />
                                    {{t "component.dropzone.files-ready-for-upload" numOfFiles=(pluralize queue.files.length (t "component.dropzone.file"))}}
                                </div>
                                <div class="my-2">({{queue.progress}}%)</div>
                            {{else}}
                                <h4 class="font-semibold">
                                    <FaIcon @icon="folder-open" @size="lg" class="text-indigo-500 mr-2" />
                                    {{t "component.dropzone.upload-documents-files"}}
                                </h4>
                                <div>
                                    {{#if dropzone.supported}}
                                        <p class="text-sm my-5">{{t "component.dropzone.dropzone-supported-files"}}</p>
                                    {{/if}}
                                    <FileUpload @name="files" @for="files" @accept={{join "," this.acceptedFileTypes}} @multiple={{true}} @onFileAdded={{this.queueFile}}>
                                        <a tabindex={{0}} class="btn btn-magic cursor-pointer ml-1">{{t "component.dropzone.or-select-button-text"}}</a>
                                    </FileUpload>
                                </div>
                            {{/if}}
                        </FileDropzone>
                    {{/let}}

                    {{#if this.uploadQueue}}
                        <div class="mx-4">
                            <div class="space-y-2 mb-4">
                                {{#each this.uploadQueue as |file|}}
                                    <div class="flex items-center justify-between bg-blue-100 border border-blue-800 py-1.5 shadow-sm rounded-lg px-4">
                                        <div class="text-xs text-blue-900 truncate">{{truncate-filename file.name 50}}</div>
                                        <div class="flex items-center text-sm">
                                            <Spinner class="text-blue-900 mr-2" />
                                            <span class="font-bold text-blue-900">{{round file.progress}}%</span>
                                        </div>
                                    </div>
                                {{/each}}
                            </div>
                        </div>
                    {{/if}}

                    <div class="grid grid-cols-2 md:grid-cols-4 gap-2 md:gap-4">
                        {{#each this.model.files as |file|}}
                            <File @file={{file}} @onDelete={{fn this.removeFile file}} @onView={{this.viewFile}} />
                        {{/each}}
                    </div>
                {{/if}}
            </div>
        </ContentPanel>

        <Spacer @height="300px" />
    </Overlay::Body>
</Overlay>